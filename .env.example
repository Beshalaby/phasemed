# Optional validated clinical adapter commands. Each value is an argv-style
# template; Phasemed does not invoke these through a shell.
# PHASEMED_RUNTIME_DIR=/absolute/path/to/local-runtime
# Segmentation must write DICOM SEG instances into {output_dir}.
# PHASEMED_SEGMENTATION_COMMAND=your-segmenter --input {input_dir} --output {output_dir}
# With the optional local TotalSegmentator stack installed:
# PHASEMED_SEGMENTATION_COMMAND=./.venv/bin/python scripts/run_totalsegmentator.py --input-dir {input_dir} --output-dir {output_dir} --study-id {study_id}
# PHASEMED_TS_DEVICE=cpu
# PHASEMED_TS_FAST=1
# Registration must write a JSON result into {output_json}.
# PHASEMED_REGISTRATION_COMMAND=your-registerer --current {current_dir} --prior {prior_dir} --output {output_json}
# With the optional SimpleITK clinical stack installed:
# PHASEMED_REGISTRATION_COMMAND=./.venv/bin/python scripts/run_sitk_registration.py --current-dir {current_dir} --prior-dir {prior_dir} --output-json {output_json} --current-model-id {current_model_id} --prior-model-id {prior_model_id}
# PHASEMED_REGISTRATION_MODE=rigid

# Optional localhost DICOM C-STORE receiver.
# PHASEMED_CSTORE_PORT=11112
# PHASEMED_CSTORE_AE_TITLE=PHASEMED
# PHASEMED_CSTORE_HOST=127.0.0.1

# Optional DICOMweb / Orthanc endpoint.
# PHASEMED_DICOMWEB_URL=http://127.0.0.1:8042/dicom-web
# PHASEMED_DICOMWEB_USER=
# PHASEMED_DICOMWEB_PASSWORD=
